NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Kimi for insight reconciliation (OpenAI-compatible endpoint)
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=moonshot/kimi-k2.5

# Optional: Kimi via NVIDIA (OpenAI-compatible endpoint)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_KIMI_MODEL=moonshotai/kimi-k2-instruct

# Fireworks-hosted generation models (OpenAI-compatible endpoint)
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b
FIREWORKS_VISION_MODEL=accounts/fireworks/models/minimax-m3

# MLflow prompt tracing (optional)
MLFLOW_ENABLE_TRACING=false
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=ai-tutor
