# Environment
ENVIRONMENT=development

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# OpenAI-compatible model providers
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_API_KEY_EMBEDDINGS=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b
FIREWORKS_VISION_MODEL=accounts/fireworks/models/minimax-m3
FIREWORKS_EMBEDDING_MODEL=fireworks/qwen3-embedding-8b
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gemma-4-31b
GEMINI_API_KEY=
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional OTLP tracing (Phoenix Cloud/self-hosted or another OTLP collector)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=learneros-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
# Example: Authorization=Bearer%20your-api-key
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SAMPLE_RATIO=1.0
# Keep false in production to avoid exporting student prompts and answers.
OTEL_CAPTURE_CONTENT=false

# Optional: Upstash Redis (REST) for shared generation cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase (path to service account key JSON)
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Optional: public R2 base URL for animation assets
# Example: https://pub-xxxxxxxx.r2.dev/animations
ANIMATIONS_R2_PUBLIC_BASE_URL=
