# Environment
ENVIRONMENT=development

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here

# Fireworks-hosted Kimi (OpenAI-compatible)
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p5

# MLflow prompt tracing (optional)
MLFLOW_ENABLE_TRACING=false
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=ai-tutor

# Firebase (path to service account key JSON)
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
